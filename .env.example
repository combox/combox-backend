APP_ENV=local
HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=15s
READY_TIMEOUT=2s
DEFAULT_LOCALE=en
STRINGS_PATH=strings
AUTH_ACCESS_SECRET=replace_with_access_secret_min_32_chars
AUTH_REFRESH_SECRET=replace_with_refresh_secret_min_32_chars
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_EMAIL_VERIFY_ENABLED=false
AUTH_EMAIL_CODE_TTL=10m
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
RESEND_API_KEY=
RESEND_FROM=Combox <noreply@your-domain.example>
RESEND_BASE_URL=https://api.resend.com
GIPHY_API_KEY=
BOT_TOKEN_PEPPER=replace_with_bot_token_pepper_min_32_chars

# Translate engine (R19 auto-translate). Empty TRANSLATE_ENGINE_URL selects
# the MyMemory free endpoint (no key; explicit source language required).
# Set a LibreTranslate-compatible base URL to enable server-side auto-detect
# of the source language (e.g. http://libretranslate:5000).
TRANSLATE_ENGINE_URL=
TRANSLATE_API_KEY=
# Optional sender email raising the free MyMemory quota (&de= parameter).
TRANSLATE_MYMEMORY_EMAIL=
TRANSLATE_TIMEOUT=8s
TRANSLATE_CACHE_TTL=24h
TRANSLATE_RATE_LIMIT_PER_MIN=30

POSTGRES_DSN=postgres://chat:password@127.0.0.1:5432/chat?sslmode=disable
VALKEY_ADDR=127.0.0.1:6379
VALKEY_PASSWORD=
VALKEY_DB=0

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=chat-media
MINIO_API_INTERNAL=minio:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_SSE_MODE=s3
MEDIA_DELETE_ORIGINAL_AFTER_HLS=false

MIGRATIONS_ENABLED=true
MIGRATIONS_PATH=migrations
POSTGRES_DB=chat

POSTGRES_USER=chat

POSTGRES_PASSWORD=password
